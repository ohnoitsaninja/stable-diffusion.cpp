+static const void * ggml_cuda_graph_stable_signature_key(ggml_cgraph * cgraph) {
+    static std::mutex signature_mutex;
+    static std::unordered_map<std::string, std::unique_ptr<int>> signature_keys;
+
+    std::string signature;
+    signature.reserve(static_cast<size_t>(cgraph->n_nodes) * 96);
+    signature += "nodes=" + std::to_string(cgraph->n_nodes);
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node == nullptr) {
+            signature += "|null";
+            continue;
+        }
+        signature += "|op=";
+        signature += ggml_op_name(node->op);
+        signature += ",type=";
+        signature += ggml_type_name(node->type);
+        signature += ",name=";
+        signature += node->name != nullptr ? node->name : "";
+        signature += ",ne=";
+        for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+            if (d != 0) {
+                signature += "x";
+            }
+            signature += std::to_string(node->ne[d]);
+        }
+        signature += ",nb=";
+        for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+            if (d != 0) {
+                signature += "x";
+            }
+            signature += std::to_string(node->nb[d]);
+        }
+    }
+
+    std::lock_guard<std::mutex> lock(signature_mutex);
+    auto it = signature_keys.find(signature);
+    if (it == signature_keys.end()) {
+        auto key = std::make_unique<int>(static_cast<int>(signature_keys.size()) + 1);
+        const void * ptr = key.get();
+        signature_keys.emplace(std::move(signature), std::move(key));
+        if (ggml_cuda_bonsai_graph_trace_enabled()) {
+            GGML_LOG_INFO("%s: new Bonsai stable graph key=%p count=%zu\n", __func__, ptr, signature_keys.size());
+        }
+        return ptr;
+    }
+    return it->second.get();
+}
